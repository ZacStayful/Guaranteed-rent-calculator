# ──────────────────────────────────────────────────────────────
# Core third-party API keys
# ──────────────────────────────────────────────────────────────
AIRBTICS_API_KEY=
PROPERTYDATA_API_KEY=
GOOGLE_PLACES_API_KEY=
TICKETMASTER_API_KEY=
PRICELABS_API_KEY=

# Dev-only: bypass rate limiting on /api/analyse when this header
# (x-calibration-bypass) matches. Leave blank in production.
CALIBRATION_BYPASS_SECRET=

# ──────────────────────────────────────────────────────────────
# Supabase — persistent storage of completed analyser reports
#
# Server-side-only inserts (no end-user auth), so we use the SERVICE
# ROLE key, not the anon key. MUST be set in Vercel project settings
# before this goes live in production. If either is missing, report
# storage silently no-ops and the live estimate is unaffected.
# ──────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret protecting internal-only endpoints — the
# GET /api/reports/count verification route, and POST /api/internal/analyse,
# which the Stayful lead database calls to run a customer's own lead through
# the analyser. Sent as the `x-internal-secret` request header. Leave unset to
# disable those endpoints entirely (they return 404).
#
# The lead database must hold the SAME value in its ANALYSER_INTERNAL_SECRET.
INTERNAL_API_SECRET=

# How many /api/internal/analyse runs one instance will accept at once before
# returning 429. Advisory only — it is per-instance, so the real spend control
# is the caller's own in-flight cap. Default 4.
INTERNAL_ANALYSE_MAX_INFLIGHT=

# ──────────────────────────────────────────────────────────────
# Monday.com CRM integration — Management Leads board
#
# Only MONDAY_API_TOKEN is strictly required — the board and column
# IDs have hardcoded defaults in src/lib/apis/monday.ts pointing at
# the Management Leads board. Set the four *_ID vars below ONLY if
# you need to override those defaults (e.g. pointing at a different
# board during testing).
#
# If MONDAY_API_TOKEN is missing, the sync silently no-ops.
# ──────────────────────────────────────────────────────────────
# Personal API token (Profile → Developers → API). KEEP SECRET.
MONDAY_API_TOKEN=

# Optional overrides — defaults point at Management Leads board + its columns
MONDAY_BOARD_ID=
MONDAY_EMAIL_COLUMN_ID=
MONDAY_LONG_TERM_LET_COLUMN_ID=
MONDAY_DEAL_ANALYSER_COLUMN_ID=
MONDAY_ADDRESS_COLUMN_ID=
MONDAY_PHONE_COLUMN_ID=
MONDAY_ALT_PHONE_COLUMN_ID=
MONDAY_FILE_COLUMN_ID=
MONDAY_STR_PROFIT_COLUMN_ID=
MONDAY_RECOMMENDATION_COLUMN_ID=
MONDAY_QUALIFIED_COLUMN_ID=
MONDAY_STATUS_COLUMN_ID=
MONDAY_ANALYSER_USES_COLUMN_ID=
MONDAY_TIME_ON_SITE_COLUMN_ID=

# Emails exempt from the free-analysis paywall (comma-separated).
# Defaults to zac@stayful.co.uk.
ANALYSER_UNLIMITED_EMAILS=

# ──────────────────────────────────────────────────────────────
# Admin area (/admin) — bulk spreadsheet upload
#
# FAILS CLOSED: if ADMIN_EMAILS or ADMIN_SESSION_SECRET is unset,
# every /admin and /api/admin route returns 404. The public analyser
# is unaffected either way.
# ──────────────────────────────────────────────────────────────
# Who may sign in. Comma-separated; each must also be @stayful.co.uk.
ADMIN_EMAILS=

# Signing key for the session cookie. Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Starting password hashes, comma-separated "email:hashHex:saltHex" entries.
# Generate with: node scripts/hash-admin-password.mjs <email>
#
# This is the bootstrap only. The moment someone resets their password the
# hash moves into the admin_users table and takes precedence for that address,
# so this var can be dropped once every admin has reset once. Leaving it set
# is harmless — the database always wins.
ADMIN_PASSWORD_HASHES=

# ── Password-reset email ──
# Needed only for "Forgot password?". Without these the reset link is never
# sent: the request is accepted (deliberately — the response must not reveal
# who is an admin) and the server logs an error, so the user waits for an
# email that is not coming. Sign-in itself works fine without them.
#
# Free Resend account, verify stayful.co.uk, then create an API key.
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "Stayful <noreply@stayful.co.uk>"
ADMIN_EMAIL_FROM=

# The origin used to build the reset link. Leave blank on Vercel — production
# is detected automatically. Set it if the app is reached on a domain Vercel
# doesn't know about, or the emailed link will point at the wrong host.
ADMIN_BASE_URL=

# ──────────────────────────────────────────────────────────────
# Bulk upload worker
# ──────────────────────────────────────────────────────────────
# Set in Vercel so the cron trigger can authenticate to the worker.
# Vercel sends it automatically as "Authorization: Bearer <value>".
CRON_SECRET=

# Rows per upload. Larger backlogs run as sequential batches of this
# size, each with its own preview and cost confirmation.
# START SMALL (e.g. 5) for the first real runs. Default 100.
BULK_MAX_ROWS=

# Rows processed simultaneously inside one worker invocation. Default 1,
# which suits Vercel Hobby's 60s function ceiling — three rows sharing one
# invocation contend for CPU (the PDF render especially) and can push it past
# the limit, killing a row after its Airbtics report is already paid for.
# On Pro (300s functions) raise this to 3.
BULK_ROW_CONCURRENCY=

# Global ceiling on rows running at once across ALL workers. This is the
# Airbtics spend-rate throttle, not just a concurrency limit. Default 6.
BULK_MAX_INFLIGHT=

# Hard cap on a single job's estimated spend, in GBP. A job over this
# is refused at both preview and start. Default 100.
BULK_MAX_JOB_COST_GBP=

# Overrides the base URL the worker self-chains to. Normally inferred
# from VERCEL_URL or the incoming request.
BULK_WORKER_URL=

# ──────────────────────────────────────────────────────────────
# Dry-run flags — for testing bulk without spending anything
#
# Unsetting the API keys does NOT give a free run: geocodePostcode
# throws without GOOGLE_PLACES_API_KEY, so every row dies at the first
# step and none of the job machinery is exercised. Use these instead.
# ──────────────────────────────────────────────────────────────
# 1 = return a deterministic analysis, call no external API.
PIPELINE_FAKE=

# 1 = log the exact Monday column payload that would be written, and
# report success, without touching the board. Pair with PIPELINE_FAKE
# to rehearse a whole job against the REAL board while mutating nothing.
MONDAY_DRY_RUN=

# ──────────────────────────────────────────────────────────────
# Misc
# ──────────────────────────────────────────────────────────────
# Meta Pixel id, injected into the root layout.
NEXT_PUBLIC_META_PIXEL_ID=

# Set to "true" to make PriceLabs the primary revenue source,
# overriding the Airbtics headline. Off by default.
PRICELABS_AS_PRIMARY=

# How long a worker invocation may keep claiming new rows, in ms. Must stay
# under the deployed maxDuration in the worker route. Default 55000, which
# suits Vercel Hobby's 60s function ceiling. On Pro, raise the route's
# maxDuration to 300 and set this to 280000.
BULK_WORKER_BUDGET_MS=
